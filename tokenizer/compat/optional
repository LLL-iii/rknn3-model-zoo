// C++11-compatible std::optional.
//
// This header shadows <optional> via -I compat.  In C++17+ builds it simply
// forwards to the real <optional> (via #include_next); in C++11 builds it
// provides the subset of std::optional used by this project, supporting
// move-only value types (copy operations instantiate the value's copy
// constructor only if actually used).
#ifndef TOKENIZER_COMPAT_OPTIONAL_H_
#define TOKENIZER_COMPAT_OPTIONAL_H_

#if __cplusplus >= 201703L
#include_next <optional>
#else

#include <new>
#include <stdexcept>
#include <type_traits>
#include <utility>

namespace std {

struct nullopt_t {
  explicit constexpr nullopt_t(int) {}
};
constexpr nullopt_t nullopt{0};

template <typename T>
class optional {
 public:
  optional() noexcept : has_(false) {}
  optional(nullopt_t) noexcept : has_(false) {}
  optional(const T& v) : has_(true) { new (ptr()) T(v); }
  optional(T&& v) : has_(true) { new (ptr()) T(std::move(v)); }

  optional(const optional& other) : has_(other.has_) {
    if (other.has_) new (ptr()) T(*other);
  }
  optional(optional&& other) : has_(other.has_) {
    if (other.has_) new (ptr()) T(std::move(*other));
  }

  ~optional() { reset(); }

  optional& operator=(nullopt_t) {
    reset();
    return *this;
  }
  optional& operator=(const optional& other) {
    if (this != &other) {
      if (other.has_) {
        if (has_) **this = *other;
        else new (ptr()) T(*other);
      } else {
        reset();
      }
      has_ = other.has_;
    }
    return *this;
  }
  optional& operator=(optional&& other) {
    if (this != &other) {
      if (other.has_) {
        if (has_) **this = std::move(*other);
        else new (ptr()) T(std::move(*other));
      } else {
        reset();
      }
      has_ = other.has_;
    }
    return *this;
  }
  optional& operator=(const T& v) {
    if (has_) **this = v;
    else { new (ptr()) T(v); has_ = true; }
    return *this;
  }
  optional& operator=(T&& v) {
    if (has_) **this = std::move(v);
    else { new (ptr()) T(std::move(v)); has_ = true; }
    return *this;
  }

  const T* operator->() const { return ptr(); }
  T* operator->() { return ptr(); }
  const T& operator*() const { return *ptr(); }
  T& operator*() { return *ptr(); }

  explicit operator bool() const noexcept { return has_; }
  bool has_value() const noexcept { return has_; }

  const T& value() const {
    if (!has_) throw std::logic_error("optional::value on empty optional");
    return *ptr();
  }
  T& value() {
    if (!has_) throw std::logic_error("optional::value on empty optional");
    return *ptr();
  }

  template <typename U>
  T value_or(U&& default_value) const {
    return has_ ? *ptr() : static_cast<T>(std::forward<U>(default_value));
  }

  template <typename... Args>
  void emplace(Args&&... args) {
    reset();
    new (ptr()) T(std::forward<Args>(args)...);
    has_ = true;
  }

  void reset() noexcept {
    if (has_) {
      ptr()->~T();
      has_ = false;
    }
  }

 private:
  T* ptr() { return reinterpret_cast<T*>(&storage_); }
  const T* ptr() const { return reinterpret_cast<const T*>(&storage_); }

  typename std::aligned_storage<sizeof(T), alignof(T)>::type storage_;
  bool has_;
};

} // namespace std

#endif // __cplusplus >= 201703L

#endif // TOKENIZER_COMPAT_OPTIONAL_H_
