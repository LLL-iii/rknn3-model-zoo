# B2 Configuration
# Automatically generated by bootstrap.sh

import option ;
import feature ;

# Compiler configuration. This definition will be used unless
# you already have defined some toolsets in your user-config.jam
# file.
if ! gcc in [ feature.values <toolset> ]
{
    using gcc ; 
}

project : default-build <toolset>gcc ;

# Python configuration
import python ;
if ! [ python.configured ]
{
    using python : 3.12 : "/home/user/rknn3-model-zoo/rknn3-model-zoo-main/rknn3_env" ;
}

# List of --with-<library> and --without-<library>
# options. If left empty, all libraries will be built.
# Options specified on the command line completely
# override this variable.
libraries =  ;

# These settings are equivalent to corresponding command-line
# options.
option.set prefix : /home/user/rknn3-model-zoo/rknn3-model-zoo-main2/jinja/build/boost_linux_x86 ;
option.set exec-prefix : /home/user/rknn3-model-zoo/rknn3-model-zoo-main2/jinja/build/boost_linux_x86 ;
option.set libdir : /home/user/rknn3-model-zoo/rknn3-model-zoo-main2/jinja/build/boost_linux_x86/lib ;
option.set includedir : /home/user/rknn3-model-zoo/rknn3-model-zoo-main2/jinja/build/boost_linux_x86/include ;

# Stop on first error
option.set keep-going : false ;
